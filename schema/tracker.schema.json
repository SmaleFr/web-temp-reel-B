{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-temp-reel-b/tracker",
  "title": "Protocole B - corps des requetes du tracker",
  "$defs": {
    "register": {
      "title": "POST /register",
      "type": "object",
      "required": ["id", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "unregister": {
      "title": "DELETE /unregister",
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" }
      }
    },
    "peers": {
      "title": "POST <serveur>/register (push du tracker vers chaque serveur)",
      "type": "array",
      "items": { "$ref": "#/$defs/register" }
    }
  }
}
