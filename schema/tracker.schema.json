{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-temp-reel-b/tracker",
  "title": "Protocole B - corps des requetes du tracker",
  "$defs": {
    "register": {
      "title": "POST /register",
      "type": "object",
      "required": ["id", "url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "peers": {
      "title": "GET /peers (reponse)",
      "type": "object",
      "required": ["peers"],
      "properties": {
        "peers": { "type": "array", "items": { "$ref": "#/$defs/register" } }
      }
    },
    "broadcast": {
      "title": "POST /broadcast",
      "type": "object",
      "required": ["route"],
      "properties": {
        "route": { "enum": ["/syn", "/syn-ack", "/ack", "/forget", "/ingress", "/health", "/pong"] },
        "method": { "enum": ["GET", "POST"] },
        "body": { "type": "object" }
      }
    },
    "broadcastResult": {
      "title": "POST /broadcast (reponse)",
      "type": "object",
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "url", "status"],
            "properties": {
              "id": { "type": "string" },
              "url": { "type": "string" },
              "status": { "type": "integer" },
              "error": { "type": "string" }
            }
          }
        }
      }
    },
    "ingress": {
      "title": "Body d'un /ingress (protocole A)",
      "type": "object",
      "required": ["action", "metadata"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "metadata": {
          "type": "object",
          "required": ["source", "target", "timestamp"],
          "properties": {
            "id": { "type": "string" },
            "source": { "type": "string" },
            "target": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "payload": { "type": "object" }
      }
    }
  }
}
